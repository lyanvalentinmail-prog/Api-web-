# Copia este archivo como .env y ajusta lo que necesites.
# El servidor NO lee .env automáticamente (no hay dependencias extra): arranca con
#   npm run start:env        (Node 20.6 o superior, usa --env-file)
# o exporta las variables tú mismo:
#   set -a && . ./.env && set +a && npm start
# TODAS las variables son opcionales: el proyecto funciona sin configurar nada
# y no requiere ninguna clave ni servicio de pago.

# Puerto e interfaz de escucha
PORT=3000
HOST=0.0.0.0

# development | production
NODE_ENV=development

# Número de proxies de confianza por delante de la app (1 en Render/Railway/Fly
# detrás de su proxy; 0 si el servidor está expuesto directamente).
TRUST_PROXY=0

# Orígenes permitidos por CORS separados por comas. "*" permite cualquiera
# (la API es pública y no usa cookies ni credenciales).
CORS_ORIGINS=*

# Registro de cada petición en consola
LOG_REQUESTS=true

# Tamaño máximo del cuerpo de las peticiones (sintaxis de Express: 256kb, 1mb…)
BODY_LIMIT=256kb

# Límites de peticiones por IP (ventana en milisegundos y máximo de peticiones)
RATE_LIMIT_GENERAL_WINDOW_MS=60000
RATE_LIMIT_GENERAL_MAX=120
RATE_LIMIT_EXTERNAL_WINDOW_MS=60000
RATE_LIMIT_EXTERNAL_MAX=30
RATE_LIMIT_WRITE_WINDOW_MS=60000
RATE_LIMIT_WRITE_MAX=20

# Caché del informe de estado (ms) y límites de las llamadas a terceros
STATUS_CACHE_TTL_MS=45000
UPSTREAM_TIMEOUT_MS=8000
UPSTREAM_MAX_BYTES=1000000
UPSTREAM_BINARY_MAX_BYTES=512000
